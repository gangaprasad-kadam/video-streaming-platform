flowchart LR
    subgraph PRODUCERS["📤 PRODUCERS  (who sends messages)"]
        VS["🎬 Video Service"]
        EI["📡 Event Ingestion"]
        EW["🎞️ Encoding Worker"]
        HAG["🌡️ Heatmap Aggregator"]
    end

    subgraph TOPICS["📨 KAFKA TOPICS  (message channels)"]
        direction TB
        K1["📼 video.uploaded\n────────────────\n3 partitions\nKey: videoId\n\nPayload: videoId,\nfilePath, creatorId"]
        K2["✅ video.processed\n────────────────\n3 partitions\nKey: videoId\n\nPayload: videoId,\nhlsPath, duration"]
        K3["👁️ viewer-interaction-events\n────────────────\n12 partitions  ← high traffic\nKey: videoId\n\nPayload: type, position,\nvideoId, userId, timestamp"]
        K4["🌡️ heatmap-aggregated\n────────────────\n6 partitions\nKey: videoId\n\nPayload: segment scores\nfor live SSE update"]
        K5["🚨 heatmap-alerts\n────────────────\n3 partitions\nKey: videoId\n\nPayload: segment, ratio\n(future: notifications)"]
    end

    subgraph CONSUMERS["📥 CONSUMERS  (who processes messages)"]
        EW2["🎞️ Encoding Worker"]
        TW["🖼️ Thumbnail Worker"]
        SUM["🤖 Summarization Service"]
        HAG2["🌡️ Heatmap Aggregator"]
        TS["📈 Trending Service"]
        HAPI["📊 Heatmap API"]
        NOTIF["🔔 Notifications\n(future)"]
    end

    VS -->|"on upload"| K1
    EI -->|"on viewer action"| K3
    EW -->|"on encode done"| K2
    HAG -->|"on aggregation"| K4
    HAG -->|"on spike"| K5

    K1 --> EW2
    K1 --> TW
    K2 --> SUM
    K3 --> HAG2
    K3 --> TS
    K4 --> HAPI
    K5 --> NOTIF

