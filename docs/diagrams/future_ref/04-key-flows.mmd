flowchart LR
    subgraph VIDEO["🎬 Video Lifecycle"]
        direction TB
        U1(["Upload"]) --> U2["status:\nuploading"]
        U2 --> U3["status:\nencoding"]
        U3 --> U4["status:\nready ✅"]
        U4 --> U5(["Viewers\ncan watch"])
    end

    subgraph HEATMAP["🔥 Heatmap Engine — How It Works"]
        direction TB
        H1(["Viewer at second 47"]) 
        H2["bucket = 47 ÷ 5 = 9\n(each 5 seconds = 1 bucket)"]
        H3["Redis:\nINCR heatmap:vid:live:9\nINCR heatmap:vid:total:9"]
        H4{{"Spike check:\nis count > 3× average?"}}
        H5["🚨 Publish\nheatmap-alert\n(viral segment!)"]
        H6["Every hour:\nFlush to PostgreSQL\n(permanent snapshot)"]
        H7["📊 Heatmap API\nserves live data"]
        H8["⚛️ Browser\nrenders color bar\n🔴🟠🟡🟢🔵"]

        H1 --> H2 --> H3
        H3 --> H4
        H4 -->|"YES"| H5
        H4 -->|"NO"| H6
        H3 --> H7 --> H8
        H6 --> H7
    end

    subgraph AUTH["🔐 Auth Flow"]
        direction TB
        A1(["Login\nrequest"]) 
        A2["bcrypt verify\npassword"]
        A3["Generate\nsession ID"]
        A4["Redis:\nsession:ID = userId\nTTL 24 hours"]
        A5["HttpOnly Cookie\n→ Browser"]
        A6{{"Next request:\ncookie present?"}}
        A7["✅ Authenticated"]
        A8["❌ 401 Unauthorized"]

        A1 --> A2 --> A3 --> A4 --> A5
        A5 --> A6
        A6 -->|"YES + Redis hit"| A7
        A6 -->|"NO / expired"| A8
    end

    subgraph TRENDING["📈 Trending Algorithm"]
        direction TB
        T1(["PLAY event\narrives"])
        T2["Kafka:\nviewer-interaction-events"]
        T3["Redis:\nZINCRBY trending:videos\n+1 score for this video"]
        T4["Periodic decay:\nolder scores worth less"]
        T5["GET /api/trending\nZREVRANGE → top 10\nin milliseconds ⚡"]

        T1 --> T2 --> T3
        T3 --> T4 --> T5
    end

    classDef flow fill:#16213e,stroke:#4fc3f7,color:#fff,font-size:13px
    classDef decision fill:#7b1fa2,stroke:#ce93d8,color:#fff,font-size:12px
    classDef alert fill:#b71c1c,stroke:#ef9a9a,color:#fff,font-size:12px
    classDef good fill:#1b5e20,stroke:#a5d6a7,color:#fff,font-size:12px
    classDef bad fill:#b71c1c,stroke:#ef9a9a,color:#fff,font-size:12px

    class H4,A6 decision
    class H5,A8 alert
    class A7 good
