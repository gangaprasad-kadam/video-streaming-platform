    classDef clientStyle fill:#1a1a2e,stroke:#e94560,color:#ffffff,font-size:13px
    classDef gatewayStyle fill:#16213e,stroke:#0f3460,color:#ffffff,font-size:13px
    classDef serviceStyle fill:#0f3460,stroke:#e94560,color:#ffffff,font-size:12px
    classDef workerStyle fill:#533483,stroke:#e94560,color:#ffffff,font-size:12px
    classDef kafkaStyle fill:#e94560,stroke:#ffffff,color:#ffffff,font-size:12px
    classDef dbStyle fill:#1b4332,stroke:#52b788,color:#ffffff,font-size:12px
    classDef infraStyle fill:#343a40,stroke:#adb5bd,color:#ffffff,font-size:12px

    class UI clientStyle
    class NGINX gatewayStyle
    class US,VS,SS,SUM,TS,EI,HA serviceStyle
    class EW,TW,HAG workerStyle
    class K1,K2,K3,K4,K5 kafkaStyle
    class PG,RD,MG dbStyle
    class ZK infraStyle
