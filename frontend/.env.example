# Copy this to .env and fill in values
# During development Vite proxies all /auth /videos etc. to localhost:80 automatically
# Only needed for standalone Docker production build

VITE_APP_NAME="VidStream"

# Backend API gateway URL — only used in Docker production mode
# Default points to backend running on the same host (port 80)
BACKEND_URL=http://host.docker.internal:80
