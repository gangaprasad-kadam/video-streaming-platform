server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # ── Proxy API calls to the backend ────────────────────────────────────
    # BACKEND_URL is set via environment variable (default: http://host.docker.internal:80)

    location /auth {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /users {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /videos {
        client_max_body_size 2g;
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /stream {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    location /summary {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    location /trending {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    location /events {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    location /heatmap {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_buffering off;   # SSE streams must not be buffered
        proxy_cache off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering no;
    }

    # ── Static assets with long-term cache ───────────────────────────────
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ── React Router fallback (must be last) ──────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
